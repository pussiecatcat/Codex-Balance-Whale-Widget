{
  "name": "api-balance-whale",
  "version": "0.3.0",
  "description": "Codex API balance and subscription usage companion for Windows and macOS",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/control.mjs open",
    "desktop": "node scripts/control.mjs desktop",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop-audit-smoke.mjs",
    "lint": "eslint .",
    "check:package": "node scripts/check-package.mjs",
    "check:architecture": "node scripts/refactor-metrics.mjs --check",
    "verify": "npm run lint && npm run test:unit && npm run check:package && npm run check:architecture && python scripts/build-release.py",
    "install:mac": "node scripts/install-macos.mjs",
    "uninstall:mac": "node scripts/uninstall-macos.mjs",
    "probe:mac": "node scripts/probe-macos.mjs"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
